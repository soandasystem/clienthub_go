# ==========================================
# Configuración de Aplicación Go
# ==========================================
PORT=8080
ENVIRONMENT=dev
VERSION=4.1
DATABASE=postgres

# ==========================================
# Base de Datos (PostgreSQL)
# ==========================================
# Para uso con el contenedor local de Docker:
DSN=host=postgres user=postgres password=postgres dbname=clienthub port=5432 sslmode=disable

# Si se usa PostgreSQL localmente fuera de Docker:
# DSN=host=localhost user=postgres password=postgres dbname=clienthub port=5432 sslmode=disable

# Si se usa base de datos remota (Cloud / Aiven / Render / AWS):
# DSN=host=<host> user=<user> password=<password> dbname=<dbname> port=<port> sslmode=require

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clienthub
POSTGRES_PORT=5432

# ==========================================
# Autenticación JWT
# ==========================================
JWT_SECRET=your-secret-token-key-change-in-production

# ==========================================
# Aspose Cloud (Opcional)
# ==========================================
ASPOSE_CLIENT_ID=
ASPOSE_CLIENT_SECRET=

# ==========================================
# Backblaze B2 (Almacenamiento S3 compatible)
# ==========================================
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_KEY_ID=
B2_PUBLIC_URL=https://f005.backblazeb2.com/file/<bucket>
B2_REGION=us-east-005
B2_S3_PUBLIC_URL=https://<bucket>.s3.us-east-005.backblazeb2.com

# ==========================================
# SMTP / Correo Electrónico
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==========================================
# Resend API
# ==========================================
API_KEY_RESEND=

# ==========================================
# pgAdmin (Herramienta visual de BD)
# ==========================================
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@clienthub.local
PGADMIN_DEFAULT_PASSWORD=admin

